{
  "name": "vscode-extension-data7",
  "displayName": "Data7 DevStudio",
  "description": "Ferramentas para desenvolvimento, sincronização e execução de projetos Data7 (.7Proj) no VS Code.",
  "version": "0.1.4",
  "publisher": "matheusdevelope",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matheusdevelope/vscode-extension-data7.git"
  },
  "scripts": {
    "vscode:prepublish": "npm run package:prepare",
    "compile": "tsc -p ./",
    "bundle": "esbuild src/extension.ts --bundle --minify --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "package:assets": "node ../../scripts/prepare-vscode-package.js",
    "package:prepare": "npm run compile -w @data7/core && npm run compile && npm run bundle && npm run package:assets",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write \"src/**/*.ts\" \"syntaxes/**/*.json\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"syntaxes/**/*.json\" \"*.json\"",
    "test": "npm run compile && node --test out/test/**/*.test.js",
    "test:watch": "tsc -watch -p ./ & node --test --watch out/test/**/*.test.js",
    "test:coverage": "npm run compile && node --test --experimental-test-coverage out/test/**/*.test.js",
    "audit:system-library": "npm run compile && node ../../scripts/audit-system-library.js",
    "docs:system-library": "npm run compile && node ../../scripts/generate-system-library-docs.js",
    "docs:examples": "node ../../scripts/generate-examples-index.js",
    "docs:examples:check": "node ../../scripts/generate-examples-index.js --check",
    "verify": "npm run compile && npm run lint && npm run format:check && npm run test && node ../../scripts/audit-system-library.js && node ../../scripts/generate-examples-index.js --check",
    "build:extension": "npx @vscode/vsce package --no-dependencies --allow-package-env-file"
  },
  "bugs": {
    "url": "https://github.com/matheusdevelope/vscode-extension-data7/issues"
  },
  "keywords": [
    "data7",
    "erp",
    "data7basic",
    "delphi",
    "language-server",
    "intellisense",
    "linter"
  ],
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=22.13.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters",
    "Other"
  ],
  "galleryBanner": {
    "color": "#0a2540",
    "theme": "dark"
  },
  "activationEvents": [
    "onLanguage:data7project",
    "workspaceContains:**/*.7proj",
    "workspaceContains:**/*.bas"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "[d7basic]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        }
      }
    },
    "languages": [
      {
        "id": "d7basic",
        "aliases": [
          "Data7 Basic",
          "d7basic"
        ],
        "extensions": [
          ".bas",
          ".d7b"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "data7project",
        "aliases": [
          "Data7 Project",
          "data7project"
        ],
        "extensions": [
          ".7proj",
          ".7Proj"
        ]
      }
    ],
    "grammars": [
      {
        "id": "d7basic",
        "language": "d7basic",
        "scopeName": "source.d7basic",
        "path": "./syntaxes/d7basic.tmLanguage.json"
      },
      {
        "language": "data7project",
        "scopeName": "text.xml.data7project",
        "path": "./syntaxes/d7project.tmLanguage.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "data7-explorer",
          "title": "Data7 Dev Studio",
          "icon": "$(package)"
        }
      ]
    },
    "views": {
      "data7-explorer": [
        {
          "id": "data7.quickActionsView",
          "name": "Ações Rápidas",
          "type": "tree"
        },
        {
          "id": "data7.modulesView",
          "name": "Gerenciador de Módulos",
          "type": "tree"
        }
      ]
    },
    "commands": [
      {
        "command": "data7.settings.open",
        "title": "Configurações",
        "category": "Data7",
        "icon": "$(settings-gear)",
        "detail": "Abre o editor de configurações da extensão (Executor, features, linter, açúcares)"
      },
      {
        "command": "data7.project.new",
        "title": "Novo Projeto",
        "category": "Data7 Projeto",
        "icon": "$(add)",
        "detail": "Cria um novo projeto Data7 com data7.json completo"
      },
      {
        "command": "data7.project.open",
        "title": "Abrir Projeto",
        "category": "Data7 Projeto",
        "icon": "$(folder-opened)",
        "detail": "Decompõe um .7Proj em estrutura .bas editável"
      },
      {
        "command": "data7.project.build",
        "title": "Compilar",
        "category": "Data7 Projeto",
        "icon": "$(tools)",
        "detail": "Empacota a árvore atual no .7Proj"
      },
      {
        "command": "data7.project.run",
        "title": "Executar",
        "category": "Data7 Projeto",
        "icon": "$(play)",
        "detail": "Executa o projeto ativo no Executor Data7"
      },
      {
        "command": "data7.project.decompose",
        "title": "Decompor",
        "category": "Data7 Projeto",
        "detail": "Decompõe o .7Proj ativo in-place em arquivos .bas"
      },
      {
        "command": "data7.project.openInDevStudio",
        "title": "Abrir no Dev Studio",
        "category": "Data7 Projeto",
        "icon": "$(link-external)",
        "detail": "Abre o projeto ativo no Developer Studio legado"
      },
      {
        "command": "data7.modules.install",
        "title": "Instalar Módulo",
        "category": "Data7 Módulos",
        "icon": "$(cloud-download)",
        "detail": "Instala um módulo do repositório no projeto ativo"
      },
      {
        "command": "data7.modules.installBulk",
        "title": "Instalar em Lote",
        "category": "Data7 Módulos",
        "detail": "Instala vários módulos de uma vez (usado por quick fixes em lote)"
      },
      {
        "command": "data7.modules.installSelected",
        "title": "Instalar Selecionados",
        "category": "Data7 Módulos",
        "icon": "$(cloud-download)",
        "detail": "Instala os módulos marcados no Gerenciador de Módulos"
      },
      {
        "command": "data7.modules.updateSelected",
        "title": "Atualizar Selecionados",
        "category": "Data7 Módulos",
        "icon": "$(sync)",
        "detail": "Atualiza os módulos marcados no Gerenciador de Módulos"
      },
      {
        "command": "data7.modules.remove",
        "title": "Remover Módulo",
        "category": "Data7 Módulos",
        "icon": "$(trash)",
        "detail": "Remove um módulo do projeto ativo"
      },
      {
        "command": "data7.modules.removeSelected",
        "title": "Remover Selecionados",
        "category": "Data7 Módulos",
        "icon": "$(trash)",
        "detail": "Remove os módulos marcados no Gerenciador de Módulos"
      },
      {
        "command": "data7.modules.updateDependencies",
        "title": "Sincronizar Dependências",
        "category": "Data7 Módulos",
        "icon": "$(sync)",
        "detail": "Instala ou atualiza todas as dependências do data7.json"
      },
      {
        "command": "data7.modules.suggestDependencies",
        "title": "Sugerir Dependências",
        "category": "Data7 Módulos",
        "icon": "$(search)",
        "detail": "Escaneia o código e sugere dependências ausentes no data7.json"
      },
      {
        "command": "data7.modules.importToRepository",
        "title": "Importar para Repositório",
        "category": "Data7 Módulos",
        "detail": "Importa um módulo ou projeto para o repositório privado da extensão"
      },
      {
        "command": "data7.modules.bulkImportToRepository",
        "title": "Importar em Lote",
        "category": "Data7 Módulos",
        "detail": "Importa vários módulos ou projetos para o repositório privado"
      },
      {
        "command": "data7.modules.exploreRepository",
        "title": "Explorar Repositório",
        "category": "Data7 Módulos",
        "icon": "$(folder-library)",
        "detail": "Abre o repositório de módulos no explorador de arquivos"
      },
      {
        "command": "data7.modules.publishLocal",
        "title": "Publicar Localmente",
        "category": "Data7 Módulos",
        "icon": "$(cloud-upload)",
        "detail": "Valida e publica o módulo ativo no repositório privado"
      },
      {
        "command": "data7.modules.publishOnline",
        "title": "Publicar Online",
        "category": "Data7 Módulos",
        "icon": "$(cloud)",
        "detail": "Valida e publica o módulo ativo no repositório remoto"
      },
      {
        "command": "data7.modules.unpublishOnline",
        "title": "Remover Online",
        "category": "Data7 Módulos",
        "icon": "$(cloud-download)",
        "detail": "Abre PR para remover módulo do repositório remoto"
      },
      {
        "command": "data7.linter.run",
        "title": "Analisar Projeto",
        "category": "Data7 Linter",
        "icon": "$(refresh)",
        "detail": "Executa o linter em todo o workspace"
      },
      {
        "command": "data7.linter.fixActiveFile",
        "title": "Corrigir Arquivo",
        "category": "Data7 Linter",
        "icon": "$(wand)",
        "detail": "Aplica correções automáticas no arquivo .bas ativo"
      },
      {
        "command": "data7.linter.fixAllWorkspace",
        "title": "Corrigir Projeto",
        "category": "Data7 Linter",
        "icon": "$(tools)",
        "detail": "Aplica todas as correções automáticas no workspace"
      },
      {
        "command": "data7.preview.transpiledCode",
        "title": "Prévia (Lado a Lado)",
        "category": "Data7 Prévia",
        "icon": "$(split-horizontal)",
        "detail": "Mostra o código transpilado em editor ao lado"
      },
      {
        "command": "data7.preview.transpiledCodeActive",
        "title": "Prévia (Aba Atual)",
        "category": "Data7 Prévia",
        "detail": "Mostra o código transpilado substituindo a aba ativa"
      },
      {
        "command": "data7.docs.generateSystemLibrary",
        "title": "Gerar System Library",
        "category": "Data7 Docs",
        "icon": "$(book)",
        "detail": "Gera documentação .md da System Library"
      },
      {
        "command": "data7.docs.injectToAgentsMd",
        "title": "Sincronizar AGENTS.md",
        "category": "Data7 Docs",
        "icon": "$(file-add)",
        "detail": "Injeta documentação da System Library no AGENTS.md"
      },
      {
        "command": "data7.mcp.installServer",
        "title": "Instalar Servidor MCP",
        "category": "Data7 MCP",
        "icon": "$(extensions)",
        "detail": "Instala ou atualiza o servidor MCP da extensão"
      },
      {
        "command": "data7.mcp.previewClientConfig",
        "title": "Configuração MCP",
        "category": "Data7 MCP",
        "icon": "$(json)",
        "detail": "Mostra JSON de configuração para Cursor, Claude ou Continue"
      },
      {
        "command": "data7.util.showOutput",
        "title": "Mostrar Saída",
        "category": "Data7",
        "icon": "$(output)",
        "detail": "Abre o canal de log da extensão Data7"
      },
      {
        "command": "data7.util.openParentFolder",
        "title": "Voltar à Pasta Pai",
        "category": "Data7",
        "detail": "Volta para a pasta pai do projeto (barra de status)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "data7.modules.installSelected",
          "when": "false"
        },
        {
          "command": "data7.modules.updateSelected",
          "when": "false"
        },
        {
          "command": "data7.modules.removeSelected",
          "when": "false"
        },
        {
          "command": "data7.modules.installBulk",
          "when": "false"
        },
        {
          "command": "data7.modules.unpublishOnline",
          "when": "false"
        },
        {
          "command": "data7.preview.transpiledCodeActive",
          "when": "false"
        },
        {
          "command": "data7.util.openParentFolder",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "data7.project.open",
          "when": "resourceExtname == .7proj",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "data7.project.open",
          "when": "resourceExtname == .7proj",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "data7.preview.transpiledCode",
          "when": "editorLangId == d7basic",
          "group": "navigation"
        },
        {
          "command": "data7.preview.transpiledCodeActive",
          "when": "editorLangId == d7basic",
          "group": "navigation"
        },
        {
          "command": "data7.linter.fixActiveFile",
          "when": "editorLangId == d7basic",
          "group": "1_modification"
        }
      ],
      "view/title": [
        {
          "command": "data7.modules.installSelected",
          "when": "view == data7.modulesView",
          "group": "navigation"
        },
        {
          "command": "data7.modules.updateSelected",
          "when": "view == data7.modulesView",
          "group": "navigation"
        },
        {
          "command": "data7.modules.removeSelected",
          "when": "view == data7.modulesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "data7.modules.install",
          "when": "view == data7.modulesView && viewItem =~ /available/ && viewItem =~ /notCurrentProject/",
          "group": "inline"
        },
        {
          "command": "data7.modules.updateDependencies",
          "when": "view == data7.modulesView && viewItem =~ /installed/ && viewItem =~ /notCurrentProject/",
          "group": "inline"
        },
        {
          "command": "data7.modules.remove",
          "when": "view == data7.modulesView && viewItem =~ /installed/ && viewItem =~ /notCurrentProject/",
          "group": "inline"
        },
        {
          "command": "data7.modules.unpublishOnline",
          "when": "view == data7.modulesView && viewItem =~ /online/ && viewItem =~ /notCurrentProject/",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "data7.project.run",
        "key": "f5",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.project.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.project.open",
        "key": "ctrl+alt+o"
      },
      {
        "command": "data7.project.new",
        "key": "ctrl+alt+n"
      },
      {
        "command": "data7.project.openInDevStudio",
        "key": "ctrl+alt+d"
      },
      {
        "command": "data7.project.decompose",
        "key": "ctrl+alt+x",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.modules.install",
        "key": "ctrl+alt+i"
      },
      {
        "command": "data7.modules.installBulk",
        "key": "ctrl+alt+shift+i"
      },
      {
        "command": "data7.modules.updateDependencies",
        "key": "ctrl+alt+u"
      },
      {
        "command": "data7.modules.importToRepository",
        "key": "ctrl+alt+m",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.modules.bulkImportToRepository",
        "key": "ctrl+alt+shift+m"
      },
      {
        "command": "data7.modules.exploreRepository",
        "key": "ctrl+alt+e"
      },
      {
        "command": "data7.linter.run",
        "key": "ctrl+alt+l",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.linter.fixActiveFile",
        "key": "ctrl+alt+shift+f",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.linter.fixAllWorkspace",
        "key": "ctrl+alt+f",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.preview.transpiledCode",
        "key": "ctrl+alt+p",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.preview.transpiledCodeActive",
        "key": "ctrl+alt+shift+p",
        "when": "editorLangId == d7basic"
      },
      {
        "command": "data7.docs.generateSystemLibrary",
        "key": "ctrl+alt+g"
      },
      {
        "command": "data7.docs.injectToAgentsMd",
        "key": "ctrl+alt+s"
      },
      {
        "command": "data7.mcp.installServer",
        "key": "ctrl+alt+j"
      },
      {
        "command": "data7.mcp.previewClientConfig",
        "key": "ctrl+alt+k"
      },
      {
        "command": "data7.util.openParentFolder",
        "key": "ctrl+alt+left"
      },
      {
        "command": "data7.util.showOutput",
        "key": "ctrl+alt+shift+o"
      }
    ],
    "walkthroughs": [
      {
        "id": "data7.gettingStarted",
        "title": "Primeiros passos com Data7 Dev Studio",
        "description": "Configure seu ambiente Data7 e descubra os principais recursos da extensão em 5 passos rápidos.",
        "steps": [
          {
            "id": "configure-executor",
            "title": "1. Configurar o executor Data7",
            "description": "Aponte a extensão para o `Executor.exe` (ou `D7MG.exe`) do seu ambiente Data7. Sem ele, F5 não consegue rodar projetos.\n[Abrir Configurações Data7](command:data7.settings.open)",
            "media": {
              "markdown": "media/walkthrough-step1.md"
            },
            "completionEvents": [
              "onCommand:data7.settings.open"
            ]
          },
          {
            "id": "open-project",
            "title": "2. Abrir um projeto .7Proj",
            "description": "Abra um `.7Proj` existente — a extensão oferece decompor a árvore para edição confortável no VS Code.\n[Abrir projeto…](command:data7.project.open)",
            "media": {
              "markdown": ""
            },
            "completionEvents": [
              "onCommand:data7.project.open"
            ]
          },
          {
            "id": "build-run",
            "title": "3. Compilar e executar",
            "description": "Use `Ctrl+Shift+B` para compilar e `F5` para rodar no Executor.\n[Compilar agora](command:data7.build)\n[Rodar agora](command:data7.project.run)",
            "media": {
              "markdown": ""
            },
            "completionEvents": [
              "onCommand:data7.build"
            ]
          },
          {
            "id": "intellisense",
            "title": "4. Use o IntelliSense",
            "description": "Hover, Go to Definition (F12), Find All References (Shift+F12), Rename (F2) e quick fixes para erros de import já estão ativos para arquivos `.bas`. Comece digitando `Imports ` para ver a lista de namespaces disponíveis.",
            "media": {
              "markdown": ""
            },
            "completionEvents": [
              "onLanguage:d7basic"
            ]
          },
          {
            "id": "sync-agents-md",
            "title": "5. Sincronizar contexto para IA (legado)",
            "description": "Se você usa Cursor / Copilot Chat, sincronize a documentação da System Library no `AGENTS.md` — agentes leem automaticamente.\n[Sincronizar AGENTS.md](command:data7.docs.injectSystemLibrary)\n\n_Esta etapa permanece como fallback; prefira o passo 6 (MCP) para entregar contexto rico sem inflar o arquivo._",
            "media": {
              "markdown": ""
            },
            "completionEvents": [
              "onCommand:data7.docs.injectSystemLibrary"
            ]
          },
          {
            "id": "install-mcp",
            "title": "6. Configurar MCP para sua IA (recomendado)",
            "description": "Instale o servidor MCP do Data7 no Cursor / Claude Desktop / Continue. Em vez de injetar 60+ k tokens em `AGENTS.md`, o MCP entrega contexto sob demanda + ferramentas executáveis (linter, transpilador) ao agente.\n[Ver instruções de instalação](command:data7.mcp.previewClientConfig)\n[Re-instalar binário](command:data7.mcp.installServer)",
            "media": {
              "markdown": ""
            },
            "completionEvents": [
              "onCommand:data7.mcp.previewClientConfig"
            ]
          }
        ]
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "d7basic",
        "scopes": {
          "class": [
            "entity.name.type.class.d7basic"
          ],
          "namespace": [
            "entity.name.namespace.d7basic"
          ],
          "method": [
            "entity.name.function.method.d7basic"
          ],
          "property": [
            "variable.other.property.d7basic"
          ],
          "variable": [
            "variable.other.d7basic"
          ],
          "event": [
            "entity.name.function.event.d7basic"
          ]
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "data7-build",
        "owner": "data7",
        "source": "Data7 Builder",
        "applyTo": "allDocuments",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(?:(?:ERROR|WARNING|ERRO|AVISO)[:\\s])?\\s*([^:\\n]+\\.(?:bas|7Proj)):(\\d+)(?::(\\d+))?:\\s*(error|warning|erro|aviso)?:?\\s*(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Em workspaces não confiáveis, recursos que executam o Executor Data7, escrevem no repositório privado ou modificam o projeto ficam desabilitados; o IntelliSense de leitura continua funcionando."
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.19.19",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.0"
  },
  "dependencies": {
    "@data7/core": "*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fast-xml-parser": "^5.8.0",
    "zod": "^3.25.0 || ^4.0.0"
  }
}
