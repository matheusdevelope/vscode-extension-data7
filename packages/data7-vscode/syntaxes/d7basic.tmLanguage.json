{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Data7 Basic",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.d7basic",
          "match": "('.*)$",
          "captures": {
            "1": {
              "patterns": [
                { "name": "keyword.control.directive.module.d7basic", "match": "@Module\\b" }
              ]
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.interpolated.d7basic",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.d7basic", "match": "\"\"|\\{\\{|\\}\\}" },
            {
              "name": "meta.embedded.expression.d7basic",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                { "include": "#keywords" },
                { "include": "#types" },
                { "include": "#constants" },
                { "include": "#identifiers" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.double.d7basic",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.d7basic", "match": "\"\"" }]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.d7basic",
          "match": "(?i)\\b(MustOverride|MustInherit|Overridable|AddHandler|Implements|ParamArray|RaiseEvent|WithEvents|AddressOf|Interface|Namespace|Narrowing|Overloads|Overrides|Protected|Structure|WriteOnly|Continue|Delegate|Function|Inherits|Operator|Optional|Property|ReadOnly|SyncLock|Widening|Declare|Default|Finally|GetType|Handles|Imports|MyClass|Partial|Private|Shadows|TryCast|CShort|ElseIf|Friend|Global|Module|MyBase|Option|Public|Resume|Return|Select|Shared|Static|TypeOf|Alias|ByRef|ByVal|Catch|CBool|CByte|CChar|CDate|Class|Const|CType|Erase|Error|Event|ReDim|Throw|Until|Using|While|Call|Case|CDbl|CDec|CInt|CLng|CObj|CSng|CStr|Each|Else|Enum|Enun|Exit|GoTo|Loop|Next|Step|Stop|Then|When|With|Dim|End|For|Get|Let|Lib|New|REM|Set|Sub|Try|As|Do|If|In|Me|Of|On|To)\\b"
        },
        {
          "name": "keyword.operator.logical.d7basic",
          "match": "(?i)\\b(AndAlso|OrElse|IsNot|Like|And|Mod|Not|Xor|Is|Or)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.d7basic",
          "match": "(?i)\\\\b(AnsiChar|AnsiString|Boolean|Border|ButtonCancel|ButtonOk|ButtonTextBox|Byte|ByteBool|Calendar|Cardinal|Char|CheckBox|Clipboard|Command|CommandButton|Connection|Control|ControlGroup|Currency|CustomControl|Date|DateTextBox|dateUtils|Decimal|Directory|Double|Ellipse|Exception|Extended|File|FlatButton|FontConfig|Form|FormButtons|Grid|GridConfigs|GridEditorLink|HComboBox|HMODULE|Hresult|IFormVisualManager|Iinterface|Imagem|Int64|Integer|IOUtils|IXMLNode|IXMLNodeList|Line|Long|LongBool|Longint|LongWord|MaskTextBox|Math|MemoTextBox|MessageBox|NumberTextBox|PageControl|Panel|PasswordTextBox|Pointer|ProgressBar|Pvoid|Real|Rectangle|Report|SearchTextBox|Short|ShortInt|Shortstring|Single|SmallInt|StaticText|String|StringList|TabSheet|TAdvColumnGrid|TAdvStringGrid|TAlign|TAlignInsertBeforeEvent|TAlignment|TAnchorKind|TAnsiStringDynArray|TBaseGrid|TBevel|TBevelCut|TBevelEdges|TBevelKind|TBevelShape|TBevelStyle|TBiDiMode|TBorderIcon|TBorderIcons|TBorderStyle|TBotao|TBoundLabel|TBrushStyle|TButtonControl|TButtonedEdit|TCanResizeEvent|TCanvas|Tclass|TCloseAction|TColor|TComponent|TConstrainedResizeEvent|TContextPopupEvent|TControl|TControlGroup|TCursor|TCustomButtonedEdit|TCustomControl|TCustomDrawGrid|TCustomEdit|TCustomForm|TCustomFrame|TCustomGrid|TCustomLabel|TCustomPanel|TCustomSpeedButton|TcxButtonEdit|TcxCalcEdit|TcxCheckBox|TcxComboBox|TcxCurrencyEdit|TcxCustomButtonEdit|TcxCustomCalcEdit|TcxCustomCheckBox|TcxCustomComboBox|TcxCustomCurrencyEdit|TcxCustomDateEdit|TcxCustomDropDownEdit|TcxCustomEdit|TcxCustomMaskEdit|TcxCustomMemo|TcxCustomPopupEdit|TcxCustomTextEdit|TcxDateEdit|TcxMaskEdit|TcxMemo|TcxTextEdit|TDataEditor|TDataSetNotifyEvent|Tdatetime|TDefaultMonitor|TDoubleBufferedMode|TDragDropEvent|TDragKind|TDragMode|TDragOverEvent|TDragState|TDrawGrid|TEditLink|TEditor|TEditorBotao|TEditorType|TEndDragEvent|TextBox|TFDAfterApplyUpdatesEvent|TFDDataSet|TFDDataSetEvent|TFDErrorEvent|TFDParam|TFDStoredActivationUsage|TFDUpdateRecordTypes|TField|TFile|TFilterDropDownColumns|TFilterOptions|TFilterRecordEvent|TFont|TFontPitch|TFontQuality|TFontStyle|TForm|TFormatType|TFormBorderStyle|TFormStyle|TFrame|TFrameCalendario|TFrameTopbar|TfrmFormulario|TfrmPaiCadastro|TFTP|TGetSiteInfoEvent|TGrade|TGraphicControl|TGridDrawingStyle|TGridDrawState|TGridFilterType|TGridLook|TGridOptions|THandle|THCheckBox|THComboBox|THelpType|THintShowLargeTextPos|THoverFixedCells|THoverRowCells|THTTP|TImage|Timer|TIntelliPan|TInvalidEntryIcon|TJSONArray|TJSONObject|TLabeledEdit|TLabelPosition|TMargins|TMascaraEditor|TMethod|TModalResult|TMouseButton|TMouseWheelEvent|TMouseWheelUpDownEvent|TMsg|TNumeroEditor|Tobject|TObjectList|TObjStringGrid|Topbar|TPath|TPen|TPenStyle|TPersistent|TPesquisaEditor|TPoint|TPopupMode|TPopupToolBarMode|TPosition|TPrimitive|TPrintScale|TProgressBarOrientation|TProgressBarState|TProgressBarStyle|TRDBMS|TRect|TRotulo|TRoundedCornerType|TRzCustomTabControl|TRzPageControl|TRzTabSheet|TScrollBarAlways|TScrollHintType|TScrollingWinControl|TScrollStyle|TScrollType|TShape|TShapeType|TShiftState|TSpeedBotao|TSpeedButton|TSSCustomButton|TStartDockEvent|TStringDynArray|TStringGrid|TStringList|TStrings|TStyleElements|TTextLineBreakStyle|TThreadFunc|TTimer|TTMSStyle|TUnDockEvent|TVAlignment|TValorEditor|TVarType|TWinControl|TWindowState|TXMLDocument|UCS4String|UTF8String|ValueTextBox|Variant|Void|WhatsappMessage|WhatsappSend|Widechar|Word|WordBool|ZipFile)\\\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.d7basic",
          "match": "(?i)\\b(Unassigned|Empty|False|Null|True)\\b"
        },
        { "name": "constant.numeric.d7basic", "match": "\\b\\d+(\\.\\d+)?\\b" }
      ]
    },
    "identifiers": {
      "patterns": [
        { "name": "entity.name.function.d7basic", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\()" }
      ]
    }
  },
  "scopeName": "source.d7basic"
}
