{
  "name": "@data7/lsp",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json && npm run bundle",
    "bundle": "esbuild dist/server.js --bundle --minify --platform=node --target=node20 --outfile=dist/server.bundled.js",
    "watch": "tsc -watch -p ./tsconfig.json",
    "test": "node --test dist/test/**/*.test.js",
    "lint": "eslint \"src/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"src/**/*.ts\" --fix --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@data7/core": "*",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "esbuild": "^0.28.0",
    "typescript": "^5.0.0"
  }
}
